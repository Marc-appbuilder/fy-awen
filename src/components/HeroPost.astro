---
interface Props {
  type: 'essay' | 'poetry' | 'photo' | 'note';
  title: string;
  slug: string;
  date: Date;
  description?: string;
  image?: string;
}

const { type, title, slug, date, description, image } = Astro.props;

const sectionMap = { essay: 'essays', poetry: 'poetry', photo: 'photos', note: 'notes' };
const href = `/${sectionMap[type]}/${slug}`;
const typeLabel = { essay: 'Essay', poetry: 'Poetry', photo: 'Photo', note: 'Note' }[type];

const dateStr = date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<article class="hero">
  {image ? (
    <div class="hero-split">
      <a href={href} class="hero-img-link">
        <div class="hero-img">
          <img src={image} alt={title} />
        </div>
      </a>
      <div class="hero-content hero-content--dark">
        <span class="label">{typeLabel}</span>
        <h2 class="hero-title">
          <a href={href}>{title}</a>
        </h2>
        {description && <p class="hero-desc">{description}</p>}
        <time class="hero-date">{dateStr}</time>
      </div>
    </div>
  ) : (
    <div class="hero-text">
      <span class="label">{typeLabel}</span>
      <h2 class="hero-title">
        <a href={href}>{title}</a>
      </h2>
      {description && <p class="hero-desc">{description}</p>}
      <time class="hero-date">{dateStr}</time>
    </div>
  )}
</article>

<style>
  .hero-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 500px;
  }

  .hero-img-link { display: block; }

  .hero-img {
    width: 100%;
    height: 100%;
    min-height: 500px;
    overflow: hidden;
    background: var(--light-gray);
  }

  .hero-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .hero-img-link:hover .hero-img img {
    transform: scale(1.03);
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 2.5rem;
    gap: 0.5rem;
  }

  .hero-content--dark {
    background: var(--black);
    color: var(--white);
  }

  .hero-content--dark .hero-title a { color: var(--white); }
  .hero-content--dark .hero-title a:hover { color: var(--accent); }
  .hero-content--dark .hero-desc { color: rgba(255, 255, 255, 0.7); }
  .hero-content--dark .hero-date { color: rgba(255, 255, 255, 0.35); }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 900;
    line-height: 1.15;
  }

  .hero-title a:hover { color: var(--accent); }

  .hero-desc {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--gray);
    flex: 1;
  }

  .hero-date {
    font-size: 0.7rem;
    color: var(--gray);
    letter-spacing: 0.04em;
  }

  .hero-text {
    border-top: 3px solid var(--black);
    padding: 2.5rem 0;
    max-width: 720px;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .hero-text .hero-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
  }

  @media (max-width: 768px) {
    .hero-split {
      grid-template-columns: 1fr;
    }

    .hero-img {
      min-height: 260px;
    }
  }
</style>
