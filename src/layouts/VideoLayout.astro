---
import BaseLayout from './BaseLayout.astro';
import { getVideoEmbed } from '../utils/media';

interface Props {
  title: string;
  description?: string;
  video: string;
  image?: string;
  date: Date;
}

const { title, description, video, image, date } = Astro.props;
const embedSrc = getVideoEmbed(video);
const isEmbed = embedSrc.includes('youtube.com/embed') || embedSrc.includes('player.vimeo.com');

const dateStr = date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout title={title} description={description} image={image}>
  <article class="video-article">
    <div class="video-player">
      {isEmbed ? (
        <iframe
          src={embedSrc}
          title={title}
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        />
      ) : (
        <video controls preload="metadata">
          <source src={video} />
        </video>
      )}
    </div>
    <div class="container">
      <header class="video-header">
        <span class="label">Video</span>
        <h1 class="video-title">{title}</h1>
        {description && <p class="video-desc">{description}</p>}
        <time class="video-date" datetime={date.toISOString()}>{dateStr}</time>
      </header>
      <div class="video-body prose">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .video-player {
    background: #000;
    width: 100%;
    aspect-ratio: 16 / 9;
    margin-bottom: 3rem;
  }

  .video-player iframe,
  .video-player video {
    width: 100%;
    height: 100%;
    display: block;
  }

  .video-header {
    max-width: 720px;
    margin: 0 auto 2rem;
    border-top: 2px solid var(--black);
    padding-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .video-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 3rem);
    font-weight: 900;
    line-height: 1.1;
  }

  .video-desc {
    font-size: 1.05rem;
    color: var(--gray);
    line-height: 1.6;
  }

  .video-date {
    font-size: 0.7rem;
    color: var(--gray);
    letter-spacing: 0.05em;
  }

  .video-body {
    max-width: 720px;
    margin: 0 auto;
    padding-bottom: 5rem;
  }
</style>
