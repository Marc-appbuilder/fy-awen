---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeedItem from '../../components/FeedItem.astro';
import { getYouTubeThumbnail } from '../../utils/media';

const videos = await getCollection('videos');
const sorted = videos.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="Videos" description="Videos.">
  <div class="container">
    <header class="page-header">
      <span class="label">Videos</span>
      <h1 class="page-title">Videos</h1>
    </header>
    <div class="feed">
      {sorted.map(post => (
        <FeedItem
          type="video"
          title={post.data.title}
          slug={post.slug}
          date={post.data.date}
          description={post.data.description}
          image={post.data.image ?? getYouTubeThumbnail(post.data.video)}
        />
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .feed { max-width: 780px; }
</style>
