---
interface Props {
  type: 'essay' | 'poetry' | 'photo' | 'note' | 'video' | 'music';
  title: string;
  slug: string;
  date: Date;
  description?: string;
  image?: string;
}

const { type, title, slug, date, description, image } = Astro.props;

const sectionMap = { essay: 'essays', poetry: 'poetry', photo: 'photos', note: 'notes', video: 'videos', music: 'music' };
const href = `/${sectionMap[type]}/${slug}`;
const typeLabel = { essay: 'Essay', poetry: 'Poetry', photo: 'Photo', note: 'Note', video: 'Video', music: 'Music' }[type];

const dateStr = date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<article class={`feed-item feed-item--${type}`}>
  {image && (
    <a href={href} class="feed-img-link" tabindex="-1" aria-hidden="true">
      <div class="feed-img">
        <img src={image} alt={title} loading="lazy" />
      </div>
    </a>
  )}

  <div class={`feed-text ${!image ? 'feed-text--no-image' : ''}`}>
    <span class="label type-label">{typeLabel}</span>
    <h2 class="feed-title">
      <a href={href}>{title}</a>
    </h2>
    {description && <p class="feed-desc">{description}</p>}
    <time class="feed-date" datetime={date.toISOString()}>{dateStr}</time>
  </div>
</article>

<style>
  /* ── Desktop layout ── */
  .feed-item {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 1.75rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--border);
    align-items: start;
  }

  .feed-item:first-of-type {
    border-top: 1px solid var(--border);
  }

  .feed-img-link { display: block; }

  .feed-img {
    width: 240px;
    height: 160px;
    overflow: hidden;
    background: var(--light-gray);
    flex-shrink: 0;
  }

  .feed-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .feed-img-link:hover .feed-img img {
    transform: scale(1.05);
  }

  .feed-text {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-top: 0.1rem;
  }

  .feed-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .feed-text--no-image {
    grid-column: 1 / -1;
  }

  .feed-title a:hover { color: var(--accent); }

  .feed-desc {
    font-size: 0.92rem;
    color: var(--gray);
    line-height: 1.55;
  }

  .feed-date {
    font-size: 0.68rem;
    color: var(--gray);
    letter-spacing: 0.05em;
    margin-top: 0.2rem;
  }

  /* ── Mobile: journal layout ── */
  @media (max-width: 600px) {
    .feed-item {
      display: flex;
      flex-direction: column;
      padding: 0 0 3rem 0;
      border-bottom: none;
      gap: 0;
    }

    .feed-item:first-of-type {
      border-top: none;
    }

    /* Text above image */
    .feed-text {
      order: -1;
      padding: 0 0 1.1rem 0;
      gap: 0.3rem;
    }

    /* Label quiet on mobile */
    .type-label {
      display: none;
    }

    .feed-title {
      font-size: 1.65rem;
    }

    /* Description hidden on mobile — title and date are enough */
    .feed-desc {
      display: none;
    }

    /* Image full bleed */
    .feed-img-link {
      margin-left: -1.5rem;
      width: calc(100% + 3rem);
    }

    .feed-img {
      width: 100%;
      height: 56vw;
      max-height: 260px;
    }
  }
</style>
