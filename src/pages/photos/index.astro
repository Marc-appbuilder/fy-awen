---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeedItem from '../../components/FeedItem.astro';

const photos = await getCollection('photos');
const sorted = photos.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="Photos" description="Photography and visual stories.">
  <div class="container">
    <header class="page-header">
      <span class="label">Photos</span>
      <h1 class="page-title">Images</h1>
      <p class="page-description">Photography and visual stories.</p>
    </header>
    <div class="feed">
      {sorted.map(post => (
        <FeedItem
          type="photo"
          title={post.data.title}
          slug={post.slug}
          date={post.data.date}
          description={post.data.description}
          image={post.data.image}
        />
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .feed { max-width: 780px; }
</style>
