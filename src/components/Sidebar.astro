---
interface SidebarPost {
  type: 'essay' | 'poetry' | 'photo' | 'note';
  title: string;
  slug: string;
  image?: string;
}

interface Props {
  recent: SidebarPost[];
  counts: { essays: number; poetry: number; photos: number; notes: number };
}

const { recent, counts } = Astro.props;

const sectionMap = { essay: 'essays', poetry: 'poetry', photo: 'photos', note: 'notes' };
const typeLabel = { essay: 'Essay', poetry: 'Poetry', photo: 'Photo', note: 'Note' };

const sections = [
  { label: 'Essays', href: '/essays', count: counts.essays },
  { label: 'Poetry', href: '/poetry', count: counts.poetry },
  { label: 'Photos', href: '/photos', count: counts.photos },
  { label: 'Notes', href: '/notes', count: counts.notes },
];
---

<aside class="sidebar">

  <section class="sidebar-section">
    <h2 class="sidebar-heading">Explore</h2>
    <ul class="explore-list">
      {sections.map(s => (
        <li>
          <a href={s.href} class="explore-link">
            <span class="explore-name">{s.label}</span>
            <span class="explore-count">{s.count}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {recent.length > 0 && (
    <section class="sidebar-section">
      <h2 class="sidebar-heading">Recently Added</h2>
      <ul class="recent-list">
        {recent.map(post => (
          <li class="recent-item">
            <a href={`/${sectionMap[post.type]}/${post.slug}`} class="recent-link">
              {post.image ? (
                <div class="recent-img">
                  <img src={post.image} alt={post.title} loading="lazy" />
                </div>
              ) : (
                <div class={`recent-img-placeholder recent-img-placeholder--${post.type}`}>
                  <span>{typeLabel[post.type][0]}</span>
                </div>
              )}
              <div class="recent-text">
                <span class="label">{typeLabel[post.type]}</span>
                <p class="recent-title">{post.title}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

</aside>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    position: sticky;
    top: 5rem;
  }

  .sidebar-heading {
    font-family: var(--font-body);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--black);
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--black);
    margin-bottom: 1rem;
  }

  /* Explore */
  .explore-list {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .explore-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.9rem;
    font-weight: 500;
    transition: color 0.15s;
  }

  .explore-link:hover { color: var(--accent); }

  .explore-count {
    font-size: 0.72rem;
    color: var(--gray);
    font-weight: 400;
  }

  /* Recently Added */
  .recent-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .recent-link {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .recent-link:hover .recent-title { color: var(--accent); }

  .recent-img {
    width: 64px;
    height: 44px;
    flex-shrink: 0;
    overflow: hidden;
    background: var(--light-gray);
  }

  .recent-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .recent-img-placeholder {
    width: 64px;
    height: 44px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1rem;
    color: var(--gray);
  }

  .recent-img-placeholder--poetry { background: #f0ede8; }
  .recent-img-placeholder--note { background: var(--off-white); border: 1px solid var(--border); }
  .recent-img-placeholder--essay { background: var(--light-gray); }

  .recent-text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .recent-title {
    font-family: var(--font-display);
    font-size: 0.88rem;
    line-height: 1.3;
    font-weight: 700;
    color: var(--black);
  }
</style>
