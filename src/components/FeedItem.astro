---
interface Props {
  type: 'essay' | 'poetry' | 'photo' | 'note';
  title: string;
  slug: string;
  date: Date;
  description?: string;
  image?: string;
}

const { type, title, slug, date, description, image } = Astro.props;

const sectionMap = { essay: 'essays', poetry: 'poetry', photo: 'photos', note: 'notes' };
const href = `/${sectionMap[type]}/${slug}`;
const typeLabel = { essay: 'Essay', poetry: 'Poetry', photo: 'Photo', note: 'Note' }[type];

const dateStr = date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<article class={`feed-item feed-item--${type}`}>
  <a href={href} class="feed-img-link" tabindex="-1" aria-hidden="true">
    <div class={`feed-img ${!image ? `feed-img--placeholder feed-img--${type}` : ''}`}>
      {image
        ? <img src={image} alt={title} loading="lazy" />
        : <span class="placeholder-glyph">{typeLabel[0]}</span>
      }
    </div>
  </a>

  <div class="feed-text">
    <span class="label">{typeLabel}</span>
    <h2 class="feed-title">
      <a href={href}>{title}</a>
    </h2>
    {description && <p class="feed-desc">{description}</p>}
    <time class="feed-date" datetime={date.toISOString()}>{dateStr}</time>
  </div>
</article>

<style>
  .feed-item {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 1.75rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--border);
    align-items: start;
  }

  .feed-item:first-of-type {
    border-top: 1px solid var(--border);
  }

  .feed-img-link { display: block; }

  .feed-img {
    width: 240px;
    height: 160px;
    overflow: hidden;
    background: var(--light-gray);
    flex-shrink: 0;
  }

  .feed-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .feed-img-link:hover .feed-img img {
    transform: scale(1.05);
  }

  /* Placeholder styling — intentional, not an error state */
  .feed-img--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .feed-img--essay    { background: #e8e6e1; }
  .feed-img--poetry   { background: #e4e0d8; border-left: 3px solid var(--accent); }
  .feed-img--photo    { background: #d8d8d8; }
  .feed-img--note     { background: #f0ede8; }

  .placeholder-glyph {
    font-family: var(--font-display);
    font-size: 3.5rem;
    font-style: italic;
    color: rgba(0,0,0,0.12);
    user-select: none;
  }

  .feed-text {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-top: 0.1rem;
  }

  .feed-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .feed-item--poetry .feed-title {
    font-style: italic;
    font-weight: 400;
  }

  .feed-title a:hover { color: var(--accent); }

  .feed-desc {
    font-size: 0.92rem;
    color: var(--gray);
    line-height: 1.55;
  }

  .feed-date {
    font-size: 0.68rem;
    color: var(--gray);
    letter-spacing: 0.05em;
    margin-top: 0.2rem;
  }

  @media (max-width: 600px) {
    .feed-item {
      grid-template-columns: 1fr;
    }

    .feed-img {
      width: 100%;
      height: 200px;
    }
  }
</style>
