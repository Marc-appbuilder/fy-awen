---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeedItem from '../../components/FeedItem.astro';

const poetry = await getCollection('poetry');
const sorted = poetry.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="Poetry" description="Poems and verses.">
  <div class="container">
    <header class="page-header">
      <span class="label">Poetry</span>
      <h1 class="page-title">Poems</h1>
      <p class="page-description">Verses, songs and moments caught in words.</p>
    </header>
    <div class="feed">
      {sorted.map(post => (
        <FeedItem
          type="poetry"
          title={post.data.title}
          slug={post.slug}
          date={post.data.date}
          description={post.data.description}
        />
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .feed { max-width: 780px; }
</style>
